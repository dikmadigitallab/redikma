generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SYSTEM_ADM
  ADMIN
  POSTADOR
  COMMON
}

enum post {
  ANIVERSARIO
  PROMOÇÃO
  TEMPODECASA
}



model autoPost {
  id        String @id @default(uuid())
  label     String
  author    String?
  type      post
  mensagem  String
  imagem    String?
  video     String?
}
model Postagem {
  id          String       @id @default(uuid())
  label       String
  authorId    String
  duration    String?
  publicado   Boolean      @default(true)
  image       String?
  video       String?
  author      User         @relation(fields: [authorId], references: [id])
  postador    String
  comentarios Comentario[]
  likes       Like[]
  createdAt   DateTime     @default(now())
}

model Like {
  id           String      @id @default(uuid())
  // Relacionamento com postagem
  postId       String?
  post         Postagem?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Relacionamento com comentário (opcional)
  comentarioId String?
  comentario   Comentario? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  // Usuário que curtiu
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  // Garante que um usuário só possa curtir uma postagem uma vez
  @@unique([postId, userId])
  // Garante que um usuário só possa curtir um comentário uma vez
  @@unique([comentarioId, userId])
}


model Comentario {
  id        String      @id @default(uuid())
  texto     String
  aprovado  Boolean    @default(true)
  postId    String
  post      Postagem    @relation(fields: [postId], references: [id])
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comentario? @relation("ComentarioToComentario", fields: [parentId], references: [id])
  children  Comentario[] @relation("ComentarioToComentario")
  createdAt DateTime    @default(now())
  likes     Like[]
}

model User {
  id          String   @id @default(uuid())
  first_acess Boolean   @default(true)
  nome        String
  username    String   @unique
  cpf         String   @unique
  senha_hash  String?
  cargo       String
  role        Roles    @default(COMMON)
  foto        String?
  telefone    String?
  email       String?  @unique
  aniversario DateTime
  admissao    DateTime
  postagens   Postagem[]
  comentarios Comentario[]
  likes       Like[]
  notifications Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationActor")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  NEW_POST
  REACTION
  PROFILE_UPDATE
  PROMOTION
  BIRTHDAY
  WORK_ANNIVERSARY
}
 
 //aceite de termos de uso sem relacionamento apenas registra o id que aceitou 
 model aceite_termos {
  id        String   @id @default(uuid())
  userId    String
  acceptedAt DateTime @default(now())
 }

 //aceite de lgpd sem relacionamento apenas registra o id que aceitou
 model aceite_lgpd {
  id        String   @id @default(uuid())
  userId    String
  acceptedAt DateTime @default(now())
 }

//aceite de politica de cookies sem relacionamento apenas registra o id, o horario, e o ip do usuario que aceitou
model aceite_cookies {
  id        String   @id @default(uuid())
  userId    String
  acceptedAt DateTime @default(now())
  ip        String?
}
