generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SYSTEM_ADM
  ADMIN
  POSTADOR
  COMMON
}

enum post {
  ANIVERSARIO
  PROMOÇÃO
  TEMPODECASA
}



model autoPost {
  id        String @id @default(uuid())
  label     String
  author    String?
  type      post
  mensagem  String
  imagem    String?
  video     String?
}
model Postagem {
  id          String       @id @default(uuid())
  label       String
  authorId    String
  duration    String?
  publicado   Boolean      @default(false)
  image       String?
  video       String?
  author      User         @relation(fields: [authorId], references: [id])
  postador    String
  comentarios Comentario[]
  likes       Like[]
  createdAt   DateTime     @default(now())
}

model Like {
  id           String      @id @default(uuid())
  // Relacionamento com postagem
  postId       String?
  post         Postagem?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Relacionamento com comentário (opcional)
  comentarioId String?
  comentario   Comentario? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  // Usuário que curtiu
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  // Garante que um usuário só possa curtir uma postagem uma vez
  @@unique([postId, userId])
  // Garante que um usuário só possa curtir um comentário uma vez
  @@unique([comentarioId, userId])
}


model Comentario {
  id        String      @id @default(uuid())
  texto     String
  aprovado  Boolean    @default(true)
  postId    String
  post      Postagem    @relation(fields: [postId], references: [id])
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comentario? @relation("ComentarioToComentario", fields: [parentId], references: [id])
  children  Comentario[] @relation("ComentarioToComentario")
  createdAt DateTime    @default(now())
  likes     Like[]
}

model User {
  id          String       @id @default(uuid())
  nome        String
  username    String       @unique
  cpf         String       @unique
  senha_hash  String?
  cargo       String
  role        Roles        @default(COMMON)
  foto        String?
  telefone    String?
  email       String?      @unique
  postagens   Postagem[]
  comentarios Comentario[]
  likes       Like[]
  aniversario DateTime
  admissao    DateTime

}